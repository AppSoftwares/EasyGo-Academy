{
  "appId": "com.easygo.academy",
  "appName": "EasyGo Academy",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0a041e",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0a041e",
      "overlaysWebView": false
    },
    "Keyboard": {
      "resize": "body",
      "style": "dark"
    }
  }
}
